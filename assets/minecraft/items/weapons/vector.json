{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": ["head", "gui", "ground", "fixed", "on_shelf"],
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:custom_model_data",
          "cases": [
            {
              "when": ["gray"],
              "model": {
                "type": "minecraft:model",
                "model": "minecraft:item/weapons/vector/gray"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "minecraft:item/weapons/vector/base"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:custom_model_data",
      "cases": [
        {
          "when": ["gray"],
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/weapons/vector/gray"
          }
        },
        {
          "when": ["reload"],
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/weapons/vector/reload"
          }
        },
        {
          "when": ["equip"],
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/weapons/vector/equip"
          }
        },
        {
          "when": ["firing"],
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/weapons/vector/firing"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:item/weapons/vector/base"
      }
    }
  },
  "swap_animation_scale": 0,
  "hand_animation_on_swap": false
}