{
    "model": {
        "type": "minecraft:select",
        "property": "minecraft:display_context",
        "cases": [{
                "when": ["head", "gui", "ground", "fixed", "on_shelf"],
                "model": {
                    "type": "minecraft:model",
                    "model": "minecraft:item/weapons/verdant/base"
                }
            }
        ],
        "fallback": {
            "type": "minecraft:select",
            "property": "minecraft:custom_model_data",
            "cases": [{
                    "when": ["reload"],
                    "model": {
                        "type": "minecraft:model",
                        "model": "minecraft:item/weapons/verdant/reload"
                    }
                }, {
                    "when": ["equip"],
                    "model": {
                        "type": "minecraft:model",
                        "model": "minecraft:item/weapons/verdant/equip"
                    }
                }, {
                    "when": ["firing"],
                    "model": {
                        "type": "minecraft:model",
                        "model": "minecraft:item/weapons/verdant/firing"
                    }
                }
            ],
            "fallback": {
                "type": "minecraft:model",
                "model": "minecraft:item/weapons/verdant/base"
            }
        }
    },
    "swap_animation_scale": 0,
    "hand_animation_on_swap": false
}
