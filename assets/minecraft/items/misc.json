{
  "swap_animation_scale": 2,
  "hand_animation_on_swap": false,
  "oversized_in_gui": true,
  "model": {
    "type": "minecraft:composite",
    "models": [
      {
        "type": "minecraft:select",
        "property": "minecraft:custom_model_data",
        "index": 0,
        "cases": [
		{
		"when": "iron_door","model":{"type": "minecraft:model","model": "minecraft:item/misc/door_template"}
		},
		{
		"when": "dither","model":{
			  "type": "minecraft:range_dispatch","property": "minecraft:custom_model_data","index": 0,"entries": [
			{"threshold": 1, "model": {"type": "minecraft:model","model": "minecraft:item/misc/dither_1","tints": [{"type": "minecraft:custom_model_data","index": 0,"default": 4294967295}]}},
			{"threshold": 2, "model": {"type": "minecraft:model","model": "minecraft:item/misc/dither_2","tints": [{"type": "minecraft:custom_model_data","index": 0,"default": 4294967295}]}},
			{"threshold": 3, "model": {"type": "minecraft:model","model": "minecraft:item/misc/dither_3","tints": [{"type": "minecraft:custom_model_data","index": 0,"default": 4294967295}]}},
			{"threshold": 4, "model": {"type": "minecraft:model","model": "minecraft:item/misc/dither_4","tints": [{"type": "minecraft:custom_model_data","index": 0,"default": 4294967295}]}},
			{"threshold": 5, "model": {"type": "minecraft:model","model": "minecraft:item/misc/dither_5","tints": [{"type": "minecraft:custom_model_data","index": 0,"default": 4294967295}]}}			
			],
			"fallback": { "type": "minecraft:model","model": "minecraft:item/misc/dither_0","tints": [{"type": "minecraft:custom_model_data","index": 0,"default": 4294967295}]}
			}
		},
    {
		"when": "disabled_slot","model":{"type": "minecraft:model","model": "minecraft:item/misc/disabled_slot"}
		},
    {
		"when": "enabled_slot","model":{"type": "minecraft:model","model": "minecraft:item/misc/enabled_slot"}
		},
		{
		"when": "shifthover", "model": {
			"type": "minecraft:condition",
          "on_false": {"type": "minecraft:model","model": "minecraft:item/none"},
          "on_true":{"type": "minecraft:model","model": "minecraft:item/misc/testing_slot"},
		  "property": "minecraft:extended_view"
		}},


		{
		"when": "armory_slots", "model": { "type": "minecraft:composite",
		"models": [
			{
			"type": "minecraft:range_dispatch","property": "minecraft:custom_model_data","index": 0,
			"entries": [
				{"threshold": 1, "model": {"type": "minecraft:model","model": "minecraft:item/guielements/armory_slot0_1"}},
				{"threshold": 2, "model": {"type": "minecraft:model","model": "minecraft:item/guielements/armory_slot0_2"}}
				], "fallback": { "type": "minecraft:model","model": "minecraft:item/none"}
			},
			{
			"type": "minecraft:range_dispatch","property": "minecraft:custom_model_data","index": 1,
			"entries": [
				{"threshold": 1, "model": {"type": "minecraft:model","model": "minecraft:item/guielements/armory_slot1_1"}},
				{"threshold": 2, "model": {"type": "minecraft:model","model": "minecraft:item/guielements/armory_slot1_2"}}
				], "fallback": { "type": "minecraft:model","model": "minecraft:item/none"}
			},
			{
			"type": "minecraft:range_dispatch","property": "minecraft:custom_model_data","index": 2,
			"entries": [
				{"threshold": 1, "model": {"type": "minecraft:model","model": "minecraft:item/guielements/armory_slot2_1"}},
				{"threshold": 2, "model": {"type": "minecraft:model","model": "minecraft:item/guielements/armory_slot2_2"}}
				], "fallback": { "type": "minecraft:model","model": "minecraft:item/none"}
			},
			{
			"type": "minecraft:range_dispatch","property": "minecraft:custom_model_data","index": 3,
			"entries": [
				{"threshold": 1, "model": {"type": "minecraft:model","model": "minecraft:item/guielements/armory_slot3_1"}},
				{"threshold": 2, "model": {"type": "minecraft:model","model": "minecraft:item/guielements/armory_slot3_2"}}
				], "fallback": { "type": "minecraft:model","model": "minecraft:item/none"}
			}
		]
		}}


        ],
		  "fallback": {
		"type": "minecraft:model",
        "model": "minecraft:item/none"
        }
      }
    ]
  }
}