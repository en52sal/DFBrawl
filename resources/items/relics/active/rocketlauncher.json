                                                "default": 4294967295
                                            }
                                        ]
                                    }
                                },
                                {
                                    "threshold": 1,
                                    "model": {
                                        "type": "minecraft:model",
                                        "model": "minecraft:item/items/rocketlauncher/held_1",
                                        "tints": [
                                            {
                                                "type": "minecraft:custom_model_data",
                                                "index": 0,
                                                "default": 4294967295
                                            }
                                        ]
                                    }
                                }
                            ]
