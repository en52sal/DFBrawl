                            {
                                "when": "reload",
                                "model": {
                                    "type": "minecraft:model",
                                    "model": "minecraft:item/items/rocketlauncher/reloading",
                                    "tints": [
                                        {
                                            "type": "minecraft:custom_model_data",
                                            "index": 0,
                                            "default": 4294967295
                                        }
                                    ]
                                }
                            },
                            {
                                "when": "rocket",
                                "model": {
                                    "type": "minecraft:model",
                                    "model": "minecraft:item/items/rocketlauncher/rocket",
                                    "tints": [
                                        {
                                            "type": "minecraft:custom_model_data",
                                            "index": 0,
                                            "default": 4294967295
                                        }
                                    ]
                                }
                            },
                            {
                                "when": "equip",
                                "model": {
                                    "type": "minecraft:range_dispatch",
                                    "property": "minecraft:custom_model_data",
