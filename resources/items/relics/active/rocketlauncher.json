                                                "type": "minecraft:model",
                                                "model": "minecraft:item/items/rocketlauncher/equip_0",
                                                "tints": [
                                                    {
                                                        "type": "minecraft:custom_model_data",
                                                        "index": 0,
                                                        "default": 4294967295
                                                    }
                                                ]
                                            }
                                        },
                                        {
                                            "threshold": 1,
                                            "model": {
                                                "type": "minecraft:model",
                                                "model": "minecraft:item/items/rocketlauncher/equip_1",
                                                "tints": [
                                                    {
                                                        "type": "minecraft:custom_model_data",
                                                        "index": 0,
                                                        "default": 4294967295
                                                    }
                                                ]
                                            }
                                        }
                                    ]
                                }
                            },
                            {
                                "when": "firing",
                                "model": {
                                    "type": "minecraft:model",
                                    "model": "minecraft:item/items/rocketlauncher/shooting",
                                    "tints": [
